# Wzorzec konfiguracji PRODUKCYJNEJ dla `docker-compose.prod.yml`.
#
# Skopiuj na VPS-ie jako `.env.prod`, uzupełnij i ustaw uprawnienia:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# `.env.prod` NIGDY nie trafia do repo (CLAUDE.md §3.9) — jest w .gitignore.
# Pełna procedura: `docs/wdrozenie.md`.

# --- aplikacja ---
ENV=prod
# WYGENERUJ NOWY, nie kopiuj z deva:  openssl rand -hex 32
# Aplikacja ODMÓWI startu przy ENV != dev z wartością domyślną lub krótszą
# niż 32 znaki (app/core/config.py, `_validate_secret_key_outside_dev`).
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Frontend i API są pod tym samym origin (Caddy), więc żądań cross-origin
# nie ma i ta lista nie jest realnie używana przez przeglądarkę. Zostaje
# ustawiona poprawnie na wypadek narzędzi zewnętrznych i żeby nie zostawiać
# tu adresu z localhosta.
CORS_ORIGINS=https://twoja-domena.pl

# --- Caddy / TLS ---
DOMAIN=twoja-domena.pl
# `internal`  → certyfikat z lokalnego CA Caddy'ego (do prób lokalnych)
# <e-mail>    → prawdziwy certyfikat przez ACME, powiadomienia na ten adres
TLS_MODE=ty@twoja-domena.pl
# PRZY PIERWSZYM URUCHOMIENIU NA NOWEJ DOMENIE odkomentuj staging: produkcyjny
# Let's Encrypt ma ostry limit BŁĘDÓW (np. źle ustawiony rekord A), który
# potrafi zablokować wystawianie certyfikatu dla domeny na ok. tydzień.
# Po zielonym przebiegu zakomentuj z powrotem i zrestartuj Caddy.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- baza i cache ---
# Hasło INNE niż w devie. Generacja:  openssl rand -base64 24
POSTGRES_USER=portfel
POSTGRES_PASSWORD=
POSTGRES_DB=portfel
# Musi zgadzać się z POSTGRES_* powyżej.
DATABASE_URL=postgresql+asyncpg://portfel:TU_TO_SAMO_HASLO@postgres:5432/portfel
REDIS_URL=redis://redis:6379/0

# --- dostawcy danych ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# NBP, Stooq i Binance nie wymagają kluczy.

# --- limity dostawców (zapytania na minutę) ---
RATE_LIMIT_STOOQ=60
RATE_LIMIT_YFINANCE=30
RATE_LIMIT_FINNHUB=60
RATE_LIMIT_BINANCE=60
RATE_LIMIT_NBP=60
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=600

# --- rate limiting API (zapytania na minutę per IP i ścieżka) ---
# Liczone po REALNYM adresie klienta — uvicorn odczytuje go z nagłówka
# `X-Forwarded-For` ufając wyłącznie Caddy'emu (`FORWARDED_ALLOW_IPS`
# ustawiane na sztywno w docker-compose.prod.yml). Nie ustawiaj tego
# ręcznie na `*`, patrz komentarz przy usłudze `api`.
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ten dokładny adres musi być dopisany w Google Cloud Console jako
# "Authorized redirect URI" — Google odrzuci logowanie przy niezgodności
# choćby o ukośnik.
GOOGLE_REDIRECT_URI=https://twoja-domena.pl/api/auth/google/callback

# --- parametry analityczne ---
RISK_FREE_RATE=0.055
SPLIT_DETECTION_THRESHOLD=0.4
MIN_OBSERVATIONS_FOR_RISK=30

# --- obserwowalność ---
# Pusty DSN = Sentry wyłączone (aplikacja startuje normalnie). Dwa osobne
# projekty w Sentry: backend (python-fastapi) i frontend (nextjs).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- backup (krok 38, infra/backup/backup.sh) ---
# Puste BACKUP_S3_* = dump powstaje lokalnie, wysyłka poza VPS jest
# POMIJANA. Do realnej ochrony danych uzupełnij wszystkie cztery.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
