# --- aplikacja ---
ENV=dev
SECRET_KEY=zmien-mnie
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
# Adres API osiągalny z PRZEGLĄDARKI (fetch leci z klienta, nie z kontenera
# `frontend`) — stąd `localhost:8000`, nie `http://api:8000` (to działałoby
# tylko server-to-server wewnątrz sieci compose).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- baza i cache ---
# POSTGRES_* zasila kontener `postgres` w docker-compose.yml; musi być
# zgodne z danymi logowania w DATABASE_URL poniżej.
POSTGRES_USER=portfel
POSTGRES_PASSWORD=portfel
POSTGRES_DB=portfel
DATABASE_URL=postgresql+asyncpg://portfel:portfel@postgres:5432/portfel
# Rola APLIKACJI (krok 44, ADR-002 warstwa 3). Musi być inna niż wyżej:
# właściciel tabel i superużytkownik omijają polityki RLS **milcząco**, więc
# API połączone jako `portfel` miałoby RLS bez zębów. Kolejność wdrożenia:
# `alembic upgrade head` (tworzy rolę bez hasła) → `make db-roles` (nadaje
# hasło stąd i prawo logowania) → restart API. Worker i CLI zostają na
# DATABASE_URL — job wyceny nie ma czyjegoś `app.user_id`.
DATABASE_URL_APP=postgresql+asyncpg://portfel_app:zmien-mnie@postgres:5432/portfel
REDIS_URL=redis://redis:6379/0

# --- dostawcy danych ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# NBP, Stooq i Binance nie wymagają kluczy. CoinGecko zamieniony na Binance
# (darmowy plan CoinGecko się wyczerpał) — brak COINGECKO_API_KEY.

# --- limity dostawców (zapytania na minutę) ---
RATE_LIMIT_STOOQ=60
RATE_LIMIT_YFINANCE=30
RATE_LIMIT_FINNHUB=60
RATE_LIMIT_BINANCE=60
RATE_LIMIT_NBP=60
# Feedy RSS są plikami statycznymi na cudzym CDN-ie, bez publikowanego limitu.
RATE_LIMIT_RSS=30
# Alpha Vantage ma limit DOBOWY (25 zapytań na darmowym planie), nie minutowy —
# ta wartość jest tylko bezpiecznikiem przed pętlą w kodzie. Realną ochroną
# budżetu jest rzadki harmonogram joba `news:sentiment` (co 120 min, jedno
# zapytanie zbiorcze na wszystkie tickery).
RATE_LIMIT_ALPHAVANTAGE=5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=600

# --- newsy (krok 46) ---
# Adresy feedów po przecinku. Pusta wartość WYŁĄCZA pobieranie z RSS w danym
# środowisku (job nadal pobierze newsy spółek zagranicznych z Finnhuba).
NEWS_RSS_FEEDS=https://www.bankier.pl/rss/wiadomosci.xml,https://www.money.pl/rss/rss.xml,https://www.stockwatch.pl/wiadomosci/feed/
# Ile dni wstecz job zapisuje. Chroni przed zaciągnięciem archiwum, gdyby feed
# nagle oddał wszystko od początku — historii z RSS i tak nie ma skąd wziąć.
NEWS_MAX_AGE_DAYS=14

# --- rate limiting API (zapytania na minutę per IP i ścieżka) ---
RATE_LIMIT_DEFAULT_PER_MINUTE=100
# DEV/E2E: 30, nie produkcyjne 5. Suita Playwright loguje się raz na scenariusz
# z jednego adresu IP, więc przy 5 każdy kolejny scenariusz dostawał 429 i nowe
# testy trzeba było doklejać do cudzych plików zamiast pisać osobne. Produkcja
# zostaje na 5 — patrz `.env.prod.example` (tam ta wartość chroni przed
# zgadywaniem hasła i nie wolno jej podnosić „dla wygody").
RATE_LIMIT_AUTH_PER_MINUTE=30

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Musi być zarejestrowany w Google Cloud Console jako "Authorized redirect URI".
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- parametry analityczne ---
RISK_FREE_RATE=0.055          # stopa referencyjna NBP, do Sharpe'a
SPLIT_DETECTION_THRESHOLD=0.4 # skok ceny d/d uruchamiający przypomnienie „sprawdź ilość"
MIN_OBSERVATIONS_FOR_RISK=30

# --- obserwowalność ---
# Pusty DSN = Sentry wyłączone. W devie zostawiamy pusty: inaczej każdy błąd
# przy pisaniu kodu zaśmiecałby projekt produkcyjny (app/core/observability.py).
SENTRY_DSN=
# Wersja kodu — `GET /api/health` i `release` w Sentry. Na produkcji skrót
# commita (patrz `.env.prod.example`), w devie wartość domyślna wystarcza.
APP_VERSION=0.1.0
