{
  "compilerOptions": {
    "target": "ES2017",
    // `webworker` dołożone dla `app/sw.ts` (krok 49) — service worker używa
    // `ServiceWorkerGlobalScope`, którego nie ma w bibliotece DOM. Świadomy
    // kompromis: alternatywą był osobny tsconfig tylko dla workera, co
    // wyjęłoby ten plik spod `tsc --noEmit` w `make check`. Koszt: kod
    // przeglądarkowy nie dostanie błędu, jeśli sięgnie po globalną nazwę
    // dostępną tylko w workerze.
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
