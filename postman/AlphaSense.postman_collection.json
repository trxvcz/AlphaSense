                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/assets/search?q=a" }
        },
        {
          "name": "Assets search - CDR (200, zapisuje assetId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('co najmniej jedno trafienie (wymaga make seed)', function () { pm.expect(json.length).to.be.above(0); });",
                  "if (json.length > 0) { pm.collectionVariables.set('assetId', json[0].id); }"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/assets/search?q=CDR" }
