          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ktos.inny@alphasense.example\",\n  \"password\": \"short\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('access_token obecny', function () { pm.expect(json.access_token).to.be.a('string').and.not.empty; });",
                  "pm.test('token_type bearer', function () { pm.expect(json.token_type).to.eql('bearer'); });",
                  "pm.test('refresh cookie ustawione', function () { pm.expect(pm.cookies.has('refresh_token')).to.be.true; });",
